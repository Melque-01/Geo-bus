# Copie para .env e ajuste. O .env NÃO vai para o git.

# --- Servidor ------------------------------------------------------------
HOST=0.0.0.0
PORTA=8000

# --- PostgreSQL/PostGIS na VM Ubuntu -------------------------------------
DB_HOST=192.168.1.149
DB_PORT=5432
DB_NAME=geo_buss
DB_USER=geo_buss
DB_PASSWORD=troque-esta-senha
DB_TIMEOUT=5

# --- OSRM (osrm-backend na VM) -------------------------------------------
OSRM_URL=http://192.168.1.149:5000
OSRM_TIMEOUT=15

# --- Velocidades médias (km/h) usadas no cálculo do tempo ----------------
VEL_CARRO=30
VEL_MOTO=35
VEL_BICICLETA=15
VEL_PE=4.8

# --- Área de atendimento (recorte do OSRM) -------------------------------
# oeste,sul,leste,norte. Pontos fora daqui são recusados com erro 400.
AREA_BBOX=-50.05,-6.20,-49.75,-5.95
